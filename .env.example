# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutripath?schema=public"

# Redis Cache & Sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=nutripath_jwt_access_secret_key_2026_super_secure
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=nutripath_jwt_refresh_secret_key_2026_ultra_secure
JWT_REFRESH_EXPIRATION=30d

# Google OAuth & Firebase
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FIREBASE_PROJECT_ID=ekhoroch

# Gemini AI (Pro 1.5)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro-latest
